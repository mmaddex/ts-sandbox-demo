{
  "name": "v5-code-blocks-on-render-sandboxes",
  "version": "0.1.0",
  "private": true,
  "description": "Run user-written TypeScript workflow blocks in Render Sandboxes",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "setup": "tsx --env-file-if-exists=.env src/setup.ts",
    "demo": "tsx --env-file-if-exists=.env src/demo.ts",
    "workflow": "tsx --env-file-if-exists=.env src/workflow.ts",
    "workflow:dev": "render workflows dev -- tsx --env-file-if-exists=.env src/workflow.ts",
    "web": "tsx --env-file-if-exists=.env src/server.ts",
    "web:dev": "RENDER_USE_LOCAL_DEV=true tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@renderinc/sdk": "1.4.0",
    "monaco-editor": "0.57.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "axios": "^1.20.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
