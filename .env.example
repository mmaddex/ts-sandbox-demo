# A Render API key for the trusted backend. Never pass this into a sandbox.
RENDER_API_KEY=rnd_...
RENDER_WORKSPACE_ID=tea-...

# Set to 1 after configuring the OpenAI brokered credential on your sandbox group (see README).
DEMO_BROKERING=0

# The workflow the editor's web server starts runs on (`npm run web`). The local task server
# (`npm run workflow:dev`) accepts any slug. On Render, render.yaml sets this from the workflow.
WORKFLOW_SLUG=sandbox-pipeline
